# Tracking & Multi-Frame Confirmation Settings

# Enable tracking (default: enabled)
export SECUREVISION__TRACKING__ENABLED=true

# Multi-frame confirmation settings
export SECUREVISION__TRACKING__FRAMES_REQUIRED=3          # Consecutive frames needed for confirmation (K)
export SECUREVISION__TRACKING__IOU_THRESHOLD=0.5          # Minimum IoU for bbox matching (0.0-1.0)
export SECUREVISION__TRACKING__MAX_AGE_FRAMES=30          # Max frames without match before track removal

# Plate-specific: OCR text agreement
export SECUREVISION__TRACKING__OCR_AGREEMENT_THRESHOLD=0.6   # Minimum agreement ratio for plate confirmation

# Temporal deduplication (cooldown period)
export SECUREVISION__TRACKING__COOLDOWN_SECONDS=30.0      # Prevent duplicate alerts (same person/plate)
